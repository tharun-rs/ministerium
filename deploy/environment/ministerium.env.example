# Listener used by the Ministerium systemd service.
SERVER_ADDR=0.0.0.0:8013

# Set a long random value and configure the same value in every GitHub webhook.
GITHUB_WEBHOOK_SECRET=

# Writable root used for clones of repositories deployed by webhook.
GITHUB_ROOT_FOLDER=/var/lib/ministerium/repos
DEPLOYMENTS_DB_PATH=/var/lib/ministerium/repos/ministerium.sqlite3
MINISTERIUM_API_TOKEN=replace-with-a-long-random-token
